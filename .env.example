# Export these variables in your shell; Spring does not automatically load .env.
DB_URL=
DB_USERNAME=
DB_PASSWORD=
# Optional separate migration job: ./mvnw flyway:migrate
MIGRATION_DB_USERNAME=
MIGRATION_DB_PASSWORD=
# Set false at runtime after migrations with a separate owner.
SPRING_FLYWAY_ENABLED=true
# Actual issuer from your Supabase project, ending in /auth/v1
SUPABASE_JWT_ISSUER=https://kjqzklzswocxbtbqohsc.supabase.co/auth/v1
# Actual issuer + /.well-known/jwks.json (asymmetric signing keys required)
SUPABASE_JWKS_URI=https://kjqzklzswocxbtbqohsc.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_JWT_AUDIENCE=authenticated
# Local Angular development; replace with the exact HTTPS frontend origin when deploying.
CORS_ALLOWED_ORIGINS=http://localhost:3000
PORT=8080
# Deployment behind a trusted HTTPS reverse proxy
REQUIRE_HTTPS=true
# HU-01: enable only after configuring the real private bucket and approved area.
REPORTES_HABILITADO=false
REPORTES_LIMITE_POR_MINUTO=5
REPORTES_LAT_MIN=
REPORTES_LAT_MAX=
REPORTES_LON_MIN=
REPORTES_LON_MAX=
SUPABASE_URL=https://kjqzklzswocxbtbqohsc.supabase.co
SUPABASE_STORAGE_BUCKET=reportes-evidencias
# Server-only secret key from your project's secret manager; never a client key.
SUPABASE_STORAGE_SECRET_KEY=
# Optional local HU-01 verification helpers; never commit a real session.
SUPABASE_PUBLISHABLE_KEY=
ACTIVATION_EMAIL=
ACTIVATION_SEND_EMAIL=true
